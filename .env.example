# Environment Variables
# Copy this file to .env.local for local development.
#
# The website build itself requires NO environment variables — Netlify Forms
# works automatically once deployed. The variables below configure the optional,
# server-only GoHighLevel lead sync (netlify/functions/form-submitted.js).
#
# Set real values ONLY in Netlify: Site configuration -> Environment variables,
# available to the Functions runtime. Never commit real values. Blank values
# here are the correct "sync disabled" state.

# --- GoHighLevel lead sync --------------------------------------------------

# Master switch. Outbound CRM calls happen ONLY when this is exactly "true".
# Any other value, including unset, means the sync is disabled (no outbound call).
GHL_SYNC_ENABLED=

# Required when GHL_SYNC_ENABLED=true. If any of these six are absent while the
# switch is on, the sync fails closed (no outbound call) and logs the missing
# variable NAMES only.
#
#   Private Integration token. Sent server-side as: Authorization: Bearer <token>
GHL_PRIVATE_INTEGRATION_TOKEN=
#   GoHighLevel location (sub-account) id
GHL_LOCATION_ID=
#   Opportunity pipeline id for website quote requests
GHL_PIPELINE_ID=
#   Pipeline stage id that new quote opportunities are created in
GHL_PIPELINE_STAGE_ID=
#   Attribution tags. Added AFTER contact upsert via the dedicated add-tags
#   endpoint (never sent through upsert, which would overwrite existing tags).
#   Both are required so lead provenance in the CRM is deterministic.
GHL_SOURCE_TAG=
GHL_QUOTE_TAG=

# Non-secret. Default: test:do-not-contact. NOT applied to ordinary customer
# leads — it exists only for the controlled test procedure and the
# native-workflow exclusion rule.
GHL_TEST_TAG=

# Optional overrides (safe defaults shown):
#   default: https://services.leadconnectorhq.com
GHL_API_BASE_URL=
#   default: v3   (sent as the "Version" request header)
GHL_API_VERSION=
#   default: 10000
GHL_REQUEST_TIMEOUT_MS=
#   label prefixed to the opportunity name, e.g. "Website quote"
GHL_OPPORTUNITY_NAME_PREFIX=
#   one of: error | warn | info | debug   (default: info)
LEAD_SYNC_LOG_LEVEL=
